# Local experiments, installed runtimes and QA evidence are not source releases.
/Temp/
/temp/
/tmp/
/runtime/
/runtimes/
/node_modules/
**/node_modules/
/.npm/
/.cache/
/.npmrc
/.yarnrc.yml
/coverage/
/.dsh/
/.aries/
/.connection/

# Host state and credentials belong to the native launcher, never this plugin.
/secrets/
/private/
/credentials/
/identities/
.env
.env.*
!.env.example
auth.json
credentials.json
device-identity.json
device_identity.json
pairing.json
tokens.json
oauth.json
*.private.json
*.secrets.json
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore

